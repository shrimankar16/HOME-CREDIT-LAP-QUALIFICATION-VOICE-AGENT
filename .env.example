# Server Configuration
PORT=3001
NODE_ENV=development

# Company Information
COMPANY_NAME="Home Credit India"
DEFAULT_AGENT_NAME="Priya"
DEFAULT_AGENT_GENDER="female"

# Twilio Configuration (for real phone calls)
# Get these from: https://www.twilio.com/console
# Leave blank to use text-only mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Webhook URL (for Twilio callbacks)
# Use ngrok URL when testing locally: https://xxxxx.ngrok.io/api
# Use your production domain in production
WEBHOOK_BASE_URL=

# Logging
LOG_LEVEL=info
